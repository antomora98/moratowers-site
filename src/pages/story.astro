---
import Base from '../layouts/Base.astro';
import TopNav from '../components/TopNav.astro';
import { landing, timeline } from '../lib/landing';
import { pages } from '../lib/pages';
// Story: the approved story (landing.json about.story, after the who line that opens About), under seven headings
// (pages.json story.sections), all but the last with a date line,
// the timeline (timeline.json) with its month index and two ledgers of record rows, then where to read next.
const m = pages.meta.story;
const s = pages.story;
// Every paragraph after the who line belongs to exactly one section, in order.
const story = landing.about.story;
s.sections.forEach((x, k) => {
  const start = k === 0 ? 1 : s.sections[k - 1].to + 1;
  if (x.from !== start || x.to < x.from) throw new Error(`story: section ${k + 1} must start at paragraph ${start}`);
});
if (s.sections[s.sections.length - 1].to !== story.length - 1) throw new Error('story: the sections do not cover every paragraph');
// Reading time for the whole page, the story and the timeline under it, at 230 words a minute. Counted here, from the
// same text the page prints, so the number has one home.
const words = (t: string) => t.trim().split(/\s+/).filter(Boolean).length;
const count = [
  ...s.sections.flatMap((x) => [x.h, x.sub ?? '']), ...story.slice(1),
  ...timeline.flatMap((t) => [...t.lines, ...(s.ledgers[t.month] ? [s.ledgers[t.month].label, ...s.ledgers[t.month].rows.flat()] : [])]),
].reduce((n, t) => n + words(t), 0);
const minutes = Math.max(1, Math.round(count / 230));
---
<Base title={m.title} description={m.description} path="/story/" fonts={['geist-serif-400', 'geist-mono-400']}
  styles={['site', 'motion', 'nav', 'brand', 'brand-about', 'read']} rain footer>
<a class="skip" href="#main">skip to the text</a>
<div class="readbar" aria-hidden="true"></div>
<TopNav here="story" />
<main id="main" class="storypage">
<p class="ln">&gt; cat story.md</p>
<h1>Story</h1>
<p class="readtime">{minutes} min read</p>
<div class="prose">
{s.sections.map((x, k) => <section aria-labelledby={`s-${k + 1}`}><h2 class="sh" id={`s-${k + 1}`}>{x.h}</h2>{x.sub && <p class="date">{x.sub}</p>}{story.slice(x.from, x.to + 1).map((p) => <p>{p}</p>)}</section>)}
</div>
<h2 class="lbl">{s.timeline_label}</h2>
<nav class="months" aria-label="timeline months">{timeline.map((t) => <a href={`#t-${t.month}`}>{t.month}</a>)}</nav>
<ol class="tl">
{timeline.map((t) => {
  const r = s.ledgers[t.month];
  return <li id={`t-${t.month}`}><h3><a href={`#t-${t.month}`} tabindex="-1"><time datetime={t.month}>{t.month}</time></a></h3><div>{t.lines.map((p) => <p>{p}</p>)}{r && <div class="rec"><p class="lk">{r.label}</p><dl>{r.rows.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl></div>}</div></li>;
})}
</ol>
<p class="links go"><a href="/case/">&gt; ls cases</a></p>
<p class="links">{pages.outside.map((o, k) => <>{k > 0 && <span class="sep" aria-hidden="true"> · </span>}<a href={o.href} rel="me noopener">{o.label}</a></>)}</p>
</main>
<script is:inline type="module" src="/js/story.js"></script>
<script is:inline type="module" src="/js/read-progress.js"></script>
</Base>
