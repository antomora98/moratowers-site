---
import { landing } from '../lib/landing';
import { pages } from '../lib/pages';
// One nav on every page (pages.json nav), in the reading order the end prompts walk: the wordmark leads to the landing,
// the current page is marked for screen readers too. The ledger is not in the nav: the cases page and each case link to it. No underlines; the colours are nav.css's.
interface Props { here: 'landing' | 'about' | 'story' | 'cases' | 'rules' | 'ledger' | 'post' | 'evals' }
const { here } = Astro.props;
---
<nav class="topnav" aria-label="site"><a class="home" href="/" aria-current={here === 'landing' ? 'page' : undefined}>{landing.name}</a><span class="links">{pages.nav.map(({ label, href }) => <a href={href} aria-current={here === label ? 'page' : undefined}>{label}</a>)}</span></nav>
